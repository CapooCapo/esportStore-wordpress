# ============================================================
# .gitignore — my-esport-theme (WordPress Theme)
# ============================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# WordPress core (should NOT be in a theme repo)
wp-admin/
wp-includes/
wp-content/plugins/
wp-content/uploads/
wp-config.php
wp-config-sample.php
wp-login.php
wp-cron.php
wp-load.php
wp-settings.php
xmlrpc.php

# Local environment / WP-CLI
.env
.env.local
.env.*.local
wp-cli.yml
wp-cli.local.yml
local-by-flywheel/
.localwp/

# Node / NPM (if ever added)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
dist/
build/

# PHP / Composer (not currently used, included for future safety)
vendor/
composer.lock

# Logs
*.log
error_log
access_log

# Cache
.cache/
*.cache

# Temporary files
*.tmp
*.temp

# FTP / deploy secrets (credentials are stored in GitHub Secrets)
.ftpconfig
sftp-config.json
CLAUDE.md

.ai/
wordpress/